<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <Description>
            This is a companion package for TestFtpServer.SftpGo.Server that
            uses the `SFTPGO_DATA_PROVIDER__PRE_LOGIN_HOOK` configuration option
            to automatically create users. A default set of users is included,
            and additional users can be created by posting to the API.
        </Description>
        <Authors>Peter T. LaComb Jr.</Authors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.MD</PackageReadmeFile>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageTags>Aspire SFTPGo sftp ftp ssh testing automation</PackageTags>
        <PackageProjectUrl>https://github.com/PeterLaComb-SSNC/TestFtpServer</PackageProjectUrl>
        <RepositoryUrl>https://github.com/PeterLaComb-SSNC/TestFtpServer</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <!-- Optional: Detect breaking changes from a previous version -->
        <!-- <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion> -->
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.MD" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" Version="13.5.3" />
        <ProjectReference Include="..\TestFtpServer.SftpGo.Server\TestFtpServer.SftpGo.Server.csproj" />

        <PackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    </ItemGroup>

</Project>
