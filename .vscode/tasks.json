{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "command": "dotnet",
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ],
            "label": "dotnet: build",
            "args": [
                "build",
                "-c",
                "Debug",
                "-nologo",
                "-verbosity:quiet",
                "/property:GenerateFullPaths=true",
                "/warnAsError",
                "/clp:Summary",
                "/clp:ForceNoAlign",
            ]
        },
        {
            "type": "process",
            "command": "docker",
            "group": "build",
            "problemMatcher": [],
            "label": "docker: build",
            "args": [
                "build",
                ".",
                "-t",
                "sftpgousers:latest",
            ]
        },
    ],
}
